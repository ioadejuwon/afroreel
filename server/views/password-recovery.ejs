<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Password recovery · AfroReel</title><%- include('partials/layout/app-icons') %><link rel="stylesheet" href="<%= adminPath %>/styles.css"></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-panel">
<div class="brand auth-brand"><img class="brand-mark" width="40" height="40" src="<%= adminPath %>/icons/icon-192.png" alt=""><div><strong>AfroReel</strong><span>Admin Studio</span></div></div>
<h1><%= ({forgot:'Forgot password?',sent:'Check your inbox',reset:'Choose a new password',unavailable:'Reset link unavailable'})[mode] %></h1>
<% if (mode === 'sent') { %><p>If this email belongs to an active member, we’ll send a reset link valid for one hour.</p>
<% } else if (mode === 'unavailable') { %><a href="<%= adminPath %>/forgot-password">Request a new reset link</a>
<% } else { %><% if (message) { %><p class="auth-error" role="alert"><%= message %></p><% } %>
<form method="post" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (mode === 'forgot') { %><label>Email address<input type="email" name="email" autocomplete="email" required></label><% } else { %><%- include('partials/new-password') %><% } %>
<button class="primary-button"><%= mode === 'forgot' ? 'Send reset link' : 'Reset password' %></button></form><% } %>
<p><a href="<%= adminPath %>/login">Back to sign in</a></p></section></main></body></html>
