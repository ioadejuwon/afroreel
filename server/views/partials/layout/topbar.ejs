<header class="topbar">
  <button class="mobile-menu-button icon-button" type="button" data-sidebar-toggle aria-label="Open navigation" aria-controls="admin-sidebar" aria-expanded="false">
    <svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg>
  </button>
  <form class="search" role="search" action="<%= adminPath %>/series" method="get">
    <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
    <input name="q" type="search" aria-label="Search series and episodes" placeholder="Search series and episodes" autocomplete="off" />
  </form>
  <div class="top-actions">
    <details class="notifications" data-notifications-url="<%= adminPath %>/api/upload-notifications">
      <summary class="icon-button" aria-label="Upload notifications" title="Upload notifications">
        <svg class="icon" aria-hidden="true"><use href="#i-bell"/></svg>
        <span class="notification-dot" aria-hidden="true" <%= catalog.queue.length ? "" : "hidden" %>></span>
      </summary>
      <section class="notification-panel" aria-label="Upload notifications">
        <h2>Upload notifications</h2>
        <div data-notification-list><%- include("upload-notifications", { queue: catalog.queue }) %></div>
      </section>
    </details>
    <form class="logout-form" method="post" action="<%= adminPath %>/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button class="ghost-button" type="submit">Log out</button>
    </form>
  </div>
</header>
