<aside class="sidebar" id="admin-sidebar" aria-label="Admin navigation">
  <div class="brand">
    <img class="brand-mark" src="<%= adminPath %>/icons/icon-192.png" alt="" width="40" height="40" />
    <div><strong>AfroReel</strong><span>Admin Studio</span></div>
  </div>

  <nav class="nav-list" aria-label="Admin pages">
    <% for (const name of ["Dashboard", "Series", "Users", "Monetization", "Analytics", "Admin team", "Settings", "My account"]) {
      if (name === "Admin team" && !access.manageTeam) continue;
      if (["Dashboard","Users","Monetization","Settings"].includes(name) && !access.manageStudio) continue; %>
      <% const view = name === "Admin team" ? "team" : name === "My account" ? "account" : name.toLowerCase(); const active = view === initialView || (view === "team" && initialView === "team-invite") || (view === "series" && initialView.startsWith("series-")) || (view === "series" && initialView === "episodes") || (view === "users" && initialView === "user-profile") || (view === "monetization" && initialView === "record-detail"); %>
      <a class="nav-item<%= active ? ' active' : '' %>" href="<%= adminPath %>/<%= view %>" data-view="<%= view %>" <%- active ? 'aria-current="page"' : '' %>>
        <svg class="icon" aria-hidden="true"><use href="#i-<%= view === "account" ? "users" : view %>"/></svg><%= name %>
      </a>
    <% } %>
  </nav>

  <div class="sidebar-card">
    <span class="account-avatar" aria-hidden="true"><%= String(admin.name || "A").slice(0, 1).toUpperCase() %></span>
    <div><strong><%= admin.name %></strong><span><%= admin.email %></span></div>
  </div>
</aside>
