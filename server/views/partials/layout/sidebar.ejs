<aside class="sidebar" id="admin-sidebar" aria-label="Admin navigation">
  <div class="brand">
    <img class="brand-mark" src="<%= adminPath %>/icons/icon-192.png" alt="" width="40" height="40" />
    <div><strong>AfroReel</strong><span>Admin Studio</span></div>
  </div>

  <nav class="nav-list" aria-label="Admin pages">
    <% for (const name of ["Dashboard", "Series", "Users", "Monetization", "Analytics", "Settings"]) { %>
      <% const view = name.toLowerCase(); const active = view === initialView || (view === "series" && initialView.startsWith("series-")); %>
      <a class="nav-item<%= active ? ' active' : '' %>" href="<%= adminPath %>/<%= view %>" data-view="<%= view %>" <%- active ? 'aria-current="page"' : '' %>>
        <svg class="icon" aria-hidden="true"><use href="#i-<%= view %>"/></svg><%= name %>
      </a>
    <% } %>
  </nav>

  <div class="sidebar-card">
    <span class="account-avatar" aria-hidden="true"><%= String(admin.name || "A").slice(0, 1).toUpperCase() %></span>
    <div><strong><%= admin.name %></strong><span><%= admin.email %></span></div>
  </div>
</aside>
