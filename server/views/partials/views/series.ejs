<%
  const draftCount = series.filter(item => item.status === "draft").length;
  const counts = { all: series.length, draft: draftCount, live: series.length - draftCount };
  const episodeTitles = new Map();
  let visibleCount = 0;
  for (const episode of episodes) {
    if (!episodeTitles.has(episode.series_id)) episodeTitles.set(episode.series_id, []);
    episodeTitles.get(episode.series_id).push(episode.title);
  }
%>
<section class="view<%= initialView === 'series' ? ' active' : '' %>" id="series" data-filter-status="<%= seriesFilter %>" aria-labelledby="library-title">
  <div class="library-heading">
    <div>
      <h1 id="library-title">Series library</h1>
      <p>Create a show first, then add and manage its episodes from the series page.</p>
    </div>
    <a class="primary-button" href="<%= adminPath %>/series/new"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Create series</a>
  </div>

  <dl class="library-metrics" aria-label="Catalog totals">
    <div><dt>Total series</dt><dd><%= counts.all %></dd></div>
    <div><dt>Total episodes</dt><dd><%= episodes.length %></dd></div>
    <div><dt>Drafts</dt><dd data-count="draft"><%= counts.draft %></dd></div>
    <div><dt>Published</dt><dd data-count="live"><%= counts.live %></dd></div>
  </dl>

  <nav class="library-filters" aria-label="Filter series by status">
    <% for (const [value, label] of [["all", "All"], ["draft", "Drafts"], ["live", "Published"]]) { %>
      <a href="<%= pageHref({status: value === 'all' ? '' : value}) %>" data-filter="<%= value %>" <%- seriesFilter === value ? 'aria-current="page"' : '' %>><%= label %> · <span data-count="<%= value %>"><%= counts[value] %></span></a>
    <% } %>
  </nav>

  <div class="poster-grid">
    <% for (const item of series) { %>
      <% const cover = posterUrl(item, "adminpreview"); const published = item.status === "live"; const statusText = published ? "Published" : "Draft"; %>
      <% const detailUrl = adminPath + "/series/" + item.series_id; const actionUrl = adminPath + "/series/" + item.id; %>
      <% const searchText = [item.title, ...(episodeTitles.get(item.id) || [])].join(" ").toLowerCase();
         const visible = (seriesFilter === "all" || seriesFilter === item.status) && searchText.includes(catalogSearch.trim().toLowerCase());
         if (visible) visibleCount++; %>
      <article class="series-card" data-series-status="<%= item.status %>" data-search-text="<%= searchText %>" <%= visible ? "" : "hidden" %>>
        <a class="series-cover" href="<%= detailUrl %>" aria-label="Open <%= item.title %>">
          <span>No cover yet</span>
          <% if (cover) { %><img src="<%= cover %>" alt="" loading="lazy" /><% } %>
          <span class="cover-badge" data-status-label><%= statusText %></span>
        </a>
        <div class="series-card-body">
          <div class="card-heading">
            <div>
              <h2><a href="<%= detailUrl %>"><%= item.title %></a></h2>
              <p><%= item.episode_count %> episode<%= Number(item.episode_count) === 1 ? '' : 's' %> · <span data-status-label><%= statusText %></span></p>
            </div>
            <details class="card-menu" name="series-actions">
              <summary aria-label="Actions for <%= item.title %>"><svg class="icon" aria-hidden="true"><use href="#i-more"/></svg></summary>
              <div class="card-menu-items">
                <a href="<%= detailUrl %>"><svg class="icon" aria-hidden="true"><use href="#i-episodes"/></svg>Manage episodes</a>
                <a href="<%= detailUrl %>/edit"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg>Edit details</a>
                <a href="<%= detailUrl %>/preview"><svg class="icon" aria-hidden="true"><use href="#i-preview"/></svg>Preview</a>
                <form method="post" action="<%= actionUrl %>/duplicate">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit"><svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg>Duplicate</button>
                </form>
                <button type="button" class="delete-series" data-title="<%= item.title %>" data-delete-series="<%= actionUrl %>/delete" data-episodes="<%= item.episode_count %>"><svg class="icon" aria-hidden="true"><use href="#i-delete"/></svg>Delete series</button>
              </div>
            </details>
          </div>
          <form method="post" action="<%= actionUrl %>/status" data-status-form data-entity-type="series">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="status" value="<%= published ? 'draft' : 'live' %>" />
            <button class="primary-button card-publish" type="submit" data-status-button>
              <svg class="icon" aria-hidden="true"><use href="#i-<%= published ? 'draft' : 'publish' %>"/></svg><span><%= published ? 'Move to draft' : 'Publish' %></span>
            </button>
          </form>
        </div>
      </article>
    <% } %>
  </div>
  <p class="empty-card" data-library-empty <%= visibleCount ? 'hidden' : '' %>><%= series.length ? 'No series match this filter or search.' : 'No series yet.' %></p>
  <p class="sr-only" role="status" data-library-feedback></p>
  <%- include("delete-series-dialog") %>
</section>
