<% if (!access.manageContent) { %><%- include("series-preview") %><% } else { %>
<section class="view active studio-page">
<% if (!selectedSeries) { %><p class="empty-card">Series not found.</p><% } else { %>
<%- include("series-hero",{item:selectedSeries, editing:false}) %>
<section class="studio-panel episodes-pane"><header><h2>Episodes</h2><a class="primary-button" href="<%= adminPath %>/series/<%= selectedSeries.series_id %>/episodes/new"><svg class="icon"><use href="#i-plus"/></svg>Add episode</a></header>
<% if (!selectedEpisodes.length) { %><p class="empty-card">No episodes yet.</p><% } %>
<% for (const episode of selectedEpisodes) { const video = videoUploadResponse(episode), path = adminPath + '/episodes/' + episode.id; %>
<article class="studio-episode" id="episode-<%= episode.id %>" tabindex="-1" data-episode-id="<%= episode.id %>" data-video-uid="<%= video.uid || '' %>">
<span class="episode-num"><%= episode.episode_number %></span><div class="episode-name"><strong><%= episode.title %></strong><small data-video-state data-state="<%= video.state %>"><%= video.label %></small></div>
<span><%= episode.is_free ? 'Free' : 'Locked · ' + episode.coin_cost + ' coins' %></span>
<span class="show-badge <%= episode.status %>" data-status-label><%= episode.status %></span>
<input type="file" accept="video/*" data-video-file hidden><button class="<%= video.activeReady ? 'primary-button' : 'ghost-button' %>" type="button" data-upload-video data-pick-video><%= video.activeReady ? 'Replace video' : 'Upload video' %></button>
<details class="card-menu" name="episode-actions"><summary aria-label="Actions for <%= episode.title %>"><svg class="icon"><use href="#i-more"/></svg></summary><div class="card-menu-items">
<button type="button" data-refresh-video <%= video.canRefresh ? '' : 'disabled' %>>Refresh status</button>
<form method="post" action="<%= path %>/status" data-status-form data-entity-type="episode"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="series-detail"><input type="hidden" name="seriesPublicId" value="<%= selectedSeries.series_id %>"><input type="hidden" name="status" value="<%= episode.status === 'draft' ? 'live' : 'draft' %>"><button data-status-button><%= episode.status === 'draft' ? 'Publish' : 'Move to draft' %></button></form>
<form method="post" action="<%= path %>/delete" data-delete-episode-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="delete-series">Delete episode</button></form></div></details>
<small class="row-feedback" role="status" data-upload-status><%= video.error || '' %></small></article><% } %></section><% } %></section>
<% } %>
