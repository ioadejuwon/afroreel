<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= ({"team":"Admin team","team-invite":"Invite admin","user-profile":"User profile","record-detail":"Transaction details","series-new":"Create series","series-episode-new":"Add episode","series-edit":"Series details","series-detail":"Series episodes","series-preview":"Catalog preview"})[initialView] || (initialView.charAt(0).toUpperCase()+initialView.slice(1)) %> · AfroReel Admin</title>
    <%- include("partials/layout/app-icons") %>
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <link rel="stylesheet" href="<%= basePath %>/admin/styles.css" />
    <link rel="stylesheet" href="<%= basePath %>/admin/series-studio.css" />
  </head>
  <body>
    <%- include("partials/layout/icons") %>
    <div class="sidebar-overlay" data-sidebar-overlay></div>
    <div class="shell">
      <%- include("partials/layout/sidebar", { admin }) %>

      <main class="workspace">
        <%- include("partials/layout/topbar", { admin, csrfToken }) %>

        <% if (initialView === "series-new" || initialView === "series-edit") { %>
          <%- include("partials/views/series-form", { editing: initialView === "series-edit", item: selectedSeries }) %>
        <% } else { %>
          <%- include("partials/views/" + initialView) %>
        <% } %>
      </main>
    </div>

    <script>
      window.AFROREEL_BASE_PATH = <%- JSON.stringify(basePath) %>;
      window.AFROREEL_POLL_STREAM = <%= pollStreamLocally %>;
    </script>
    <script src="<%= basePath %>/admin/app.js?v=<%= adminScriptVersion %>"></script>
  </body>
</html>
