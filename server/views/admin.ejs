<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AfroReel Admin</title>
    <%- include("partials/layout/app-icons") %>
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <link rel="stylesheet" href="<%= basePath %>/admin/styles.css" />
  </head>
  <body>
    <%- include("partials/layout/icons") %>
    <div class="sidebar-overlay" data-sidebar-overlay></div>
    <div class="shell">
      <%- include("partials/layout/sidebar", { admin }) %>

      <main class="workspace">
        <%- include("partials/layout/topbar", { admin, csrfToken }) %>

        <h1 id="view-title" <%= initialView.startsWith("series") ? "hidden" : "" %>><%= initialView.charAt(0).toUpperCase() + initialView.slice(1) %></h1>
        <%- include("partials/views/dashboard") %>
        <%- include("partials/views/series") %>
        <%- include("partials/views/series-form", { editing: false, item: null }) %>
        <% if (initialView === "series-edit") { %><%- include("partials/views/series-form", { editing: true, item: selectedSeries }) %><% } %>
        <% if (initialView === "series-preview") { %><%- include("partials/views/series-preview") %><% } %>
        <%- include("partials/views/series-detail") %>
        <%- include("partials/views/episodes") %>
        <%- include("partials/views/users") %>
        <%- include("partials/views/monetization") %>
        <%- include("partials/views/analytics") %>
        <%- include("partials/views/settings") %>
      </main>
    </div>

    <script>
      window.AFROREEL_BASE_PATH = <%- JSON.stringify(basePath) %>;
      window.AFROREEL_INITIAL_VIEW = <%- JSON.stringify(initialView || "") %>;
      window.AFROREEL_POLL_STREAM = <%= pollStreamLocally %>;
    </script>
    <script src="<%= basePath %>/admin/app.js?v=<%= adminScriptVersion %>"></script>
  </body>
</html>
