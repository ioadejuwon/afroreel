{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://rellowmedia.com/afroreel"
      },
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://rellowmedia.com/afroreel"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
