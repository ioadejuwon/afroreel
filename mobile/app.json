{
  "expo": {
    "name": "AfroReel",
    "slug": "afroreel",
    "owner": "rellow-media",
    "extra": {
      "eas": {
        "projectId": "8cd3dde0-5d63-418c-b9fa-d3726f0b38b0"
      }
    },
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0F",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.afroreel.app",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Required for profile photo.",
        "NSPhotoLibraryUsageDescription": "Required to select a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.afroreel.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F"
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "scheme": "afroreel",
    "experiments": {
      "typedRoutes": true
    }
  }
}
